#compdef keb

autoload -U is-at-least

_keb() {
    typeset -A opt_args
    typeset -a _arguments_options
    local ret=1

    if is-at-least 5.2; then
        _arguments_options=(-s -S -C)
    else
        _arguments_options=(-s -C)
    fi

    local context curcontext="$curcontext" state line
    _arguments "${_arguments_options[@]}" : \
'--separator=[Emit this character between words instead of \`-\`]:CHAR:_default' \
'--max-length=[Override the 255 byte / UTF-16 unit name limit]:N:_default' \
'--format=[How to print each rename; \`json\` and \`null\` are the parse-safe ones]:FMT:((arrow\:"\`old -> new\`"
old\:"The name before the rename"
new\:"The name after the rename"
json\:"One JSON object per line\: \`{"from"\:"...","to"\:"..."}\`"
null\:"\`old\\0new\\0\`, for \`xargs -0\`"))' \
'-n[Print the plan, change nothing]' \
'--dry-run[Print the plan, change nothing]' \
'-r[Recurse into directories]' \
'--recursive[Recurse into directories]' \
'-f[Overwrite on collision, and rename protected names under -r]' \
'--force[Overwrite on collision, and rename protected names under -r]' \
'-d[Permit renaming directories. Without it, only files are renamed]' \
'--allow-dirs[Permit renaming directories. Without it, only files are renamed]' \
'-0[Paths on stdin are null-separated, for \`find -print0\`]' \
'--null[Paths on stdin are null-separated, for \`find -print0\`]' \
'--ascii[Narrow the output to ASCII, dropping scripts that are otherwise kept]' \
'--absolute[Print absolute paths. Lexical only — symlinks are not resolved]' \
'--list-protected[List the names keb never renames, and why. Renames nothing]' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
'-V[Print version]' \
'--version[Print version]' \
'*::paths -- Paths to rename. `-` reads a list from stdin:_files' \
&& ret=0
}

(( $+functions[_keb_commands] )) ||
_keb_commands() {
    local commands; commands=()
    _describe -t commands 'keb commands' commands "$@"
}

if [ "$funcstack[1]" = "_keb" ]; then
    _keb "$@"
else
    compdef _keb keb
fi
